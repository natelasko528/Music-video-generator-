## 🌐 **End-to-End Testing**

E2E tests use **Playwright** to simulate real user interactions.

### **Setup Playwright**

```bash
# Install Playwright
npm install -D @playwright/test

# Install browsers
npx playwright install

# Run E2E tests
npm run test:e2e
```

### **E2E Test Examples**

**Complete Onboarding Flow** (`e2e/onboarding-flow.spec.ts`)

```typescript
import { test, expect } from '@playwright/test';

test.describe('Complete Onboarding Flow', () => {
  test('should complete all 5 stages', async ({ page }) => {
    await page.goto('/onboarding/stage-1');
    
    // Stage 1: Company Information
    await page.fill('[name="companyName"]', 'Test Company');
    await page.selectOption('[name="industry"]', 'technology');
    await page.fill('[name="employees"]', '11-50');
    await page.fill('[name="website"]', 'https://test.com');
    await page.click('button[type="submit"]');
    
    // Verify navigation to Stage 2
    await expect(page).toHaveURL('/onboarding/stage-2');
    
    // Stage 2: Contact Information
    await page.fill('[name="firstName"]', 'John');
    await page.fill('[name="lastName"]', 'Doe');
    await page.fill('[name="email"]', 'john@test.com');
    await page.fill('[name="phone"]', '+1234567890');
    await page.click('button[type="submit"]');
    
    // Continue through remaining stages...
    
    // Final verification
    await expect(page).toHaveURL('/onboarding/complete');
    await expect(page.getByText(/thank you/i)).toBeVisible();
  });
  
  test('should save progress on navigation away', async ({ page }) => {
    await page.goto('/onboarding/stage-1');
    
    // Fill partial data
    await page.fill('[name="companyName"]', 'Draft Company');
    
    // Navigate away
    await page.goto('/');
    
    // Return to form
    await page.goto('/onboarding/stage-1');
    
    // Verify data persisted
    const companyName = await page.inputValue('[name="companyName"]');
    expect(companyName).toBe('Draft Company');
  });
});
```

**GHL Connection Flow** (`e2e/ghl-oauth.spec.ts`)

```typescript
test.describe('GHL OAuth Connection', () => {
  test('should connect GHL account', async ({ page, context }) => {
    await page.goto('/dashboard/settings');
    
    // Click connect button
    const [popup] = await Promise.all([
      context.waitForEvent('page'),
      page.click('text=Connect GoHighLevel')
    ]);
    
    // Wait for OAuth page
    await popup.waitForLoadState();
    expect(popup.url()).toContain('oauth/authorize');
    
    // Fill credentials (in test environment)
    await popup.fill('[name="email"]', process.env.TEST_GHL_EMAIL!);
    await popup.fill('[name="password"]', process.env.TEST_GHL_PASSWORD!);
    await popup.click('button[type="submit"]');
    
    // Wait for redirect back
    await page.waitForURL('/dashboard/settings?connected=true');
    
    // Verify connection status
    await expect(page.getByText(/connected/i)).toBeVisible();
  });
});
```

