## 🔗 **Integration Testing**

Integration tests verify that multiple components work together correctly.

### **Database Integration Tests**

```typescript
import { createClient } from '@supabase/supabase-js';

describe('Form Submission Integration', () => {
  let supabase;
  
  beforeAll(() => {
    supabase = createClient(
      process.env.NEXT_PUBLIC_SUPABASE_URL!,
      process.env.SUPABASE_SERVICE_ROLE_KEY!
    );
  });
  
  it('should save form and create GHL record', async () => {
    // Submit form
    const response = await fetch('/api/form/submit', {
      method: 'POST',
      body: JSON.stringify({
        stage: 1,
        data: { companyName: 'Test Corp' }
      })
    });
    
    const { formId } = await response.json();
    
    // Verify in database
    const { data } = await supabase
      .from('form_submissions')
      .select('*')
      .eq('id', formId)
      .single();
    
    expect(data).toBeDefined();
    expect(data.data.companyName).toBe('Test Corp');
  });
});
```

### **GHL OAuth Flow Integration Test**

```typescript
describe('GHL OAuth Integration', () => {
  it('should complete full OAuth flow', async () => {
    // 1. Get authorization URL
    const authResponse = await fetch('/api/auth/ghl/authorize');
    const { url } = await authResponse.json();
    expect(url).toContain('oauth/authorize');
    
    // 2. Simulate callback with code
    const callbackResponse = await fetch('/api/auth/ghl/callback?code=test-code&state=test-state');
    expect(callbackResponse.status).toBe(200);
    
    // 3. Verify token stored
    const { data } = await supabase
      .from('ghl_tokens')
      .select('access_token')
      .single();
    
    expect(data.access_token).toBeDefined();
  });
});
```

