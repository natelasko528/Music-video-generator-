## 📊 **Test Data Management**

### **Test Database Setup**

```typescript
// tests/setup.ts
import { createClient } from '@supabase/supabase-js';

export const setupTestDB = async () => {
  const supabase = createClient(
    process.env.TEST_SUPABASE_URL!,
    process.env.TEST_SUPABASE_KEY!
  );
  
  // Clean existing data
  await supabase.from('form_submissions').delete().neq('id', '');
  await supabase.from('ghl_tokens').delete().neq('id', '');
  
  // Seed test data
  await supabase.from('organizations').insert([
    { id: 'test-org-1', name: 'Test Org 1' },
    { id: 'test-org-2', name: 'Test Org 2' }
  ]);
};

export const teardownTestDB = async () => {
  // Clean up after tests
};
```

### **Test Fixtures**

```typescript
// tests/fixtures/forms.ts
export const validStage1Data = {
  companyName: 'Test Company',
  industry: 'technology',
  employees: '11-50',
  website: 'https://test.com',
  description: 'Test description'
};

export const invalidStage1Data = {
  companyName: '', // Missing required field
  industry: 'invalid-industry'
};
```

