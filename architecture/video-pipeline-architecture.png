## 🎯 **Testing Overview**

### **Testing Philosophy**

Our testing strategy follows the **Testing Pyramid**:
- **70% Unit Tests** - Fast, isolated, high coverage
- **20% Integration Tests** - Component interactions
- **10% E2E Tests** - Critical user flows

### **Test Coverage Goals**

- **Overall:** 80%+ coverage
- **Critical paths:** 95%+ coverage
- **Business logic:** 90%+ coverage
- **UI components:** 70%+ coverage

### **Testing Stack**

- **Unit/Integration:** Jest + React Testing Library
- **E2E:** Playwright
- **API:** Supertest
- **Load:** Artillery
- **Security:** OWASP ZAP, npm audit

---

## 🧪 **Unit Testing**

### **Setup**

Unit tests use **Jest** and **React Testing Library**.

**Run tests:**
```bash
# Run all tests
npm test

# Run with coverage
npm run test:coverage

# Run in watch mode
npm run test:watch

# Run specific file
npm test Stage1Form.test.tsx
```

### **Test Structure**

```typescript
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { Stage1Form } from '@/components/forms/Stage1Form';

describe('Stage1Form', () => {
  it('should render all form fields', () => {
    render(<Stage1Form />);
    
    expect(screen.getByLabelText(/company name/i)).toBeInTheDocument();
    expect(screen.getByLabelText(/industry/i)).toBeInTheDocument();
  });
  
  it('should validate required fields', async () => {
    render(<Stage1Form />);
    
    const submitButton = screen.getByRole('button', { name: /continue/i });
    fireEvent.click(submitButton);
    
    await waitFor(() => {
      expect(screen.getByText(/company name is required/i)).toBeInTheDocument();
    });
  });
});
```

### **Frontend Unit Tests**

**Form Validation Tests** (`src/__tests__/validations/stage1.test.ts`)

```typescript
import { stage1Schema } from '@/lib/validations/stage1';

describe('Stage 1 Validation', () => {
  it('should accept valid company data', () => {
    const validData = {
      companyName: 'Acme Corp',
      industry: 'technology',
      employees: '11-50',
      website: 'https://acme.com',
      description: 'Software company'
    };
    
    const result = stage1Schema.safeParse(validData);
    expect(result.success).toBe(true);
  });
  
  it('should reject invalid email format', () => {
    const invalidData = {
      companyName: 'Acme',
      contactEmail: 'not-an-email'
    };
    
    const result = stage1Schema.safeParse(invalidData);
    expect(result.success).toBe(false);
    expect(result.error.issues[0].path).toContain('contactEmail');
  });
});
```

**Component Tests** (`src/__tests__/components/`)

```typescript
describe('ProgressIndicator', () => {
  it('should highlight current stage', () => {
    render(<ProgressIndicator currentStage={2} totalStages={5} />);
    
    const stage2 = screen.getByText('2');
    expect(stage2).toHaveClass('bg-purple-600');
  });
  
  it('should mark completed stages', () => {
    render(<ProgressIndicator currentStage={3} totalStages={5} />);
    
    const stage1 = screen.getByText('1');
    expect(stage1).toHaveClass('bg-green-500');
  });
});
```

### **Backend Unit Tests**

**API Route Tests** (`src/app/api/__tests__/`)

```typescript
import { POST } from '@/app/api/form/submit/route';
import { NextRequest } from 'next/server';

describe('/api/form/submit', () => {
  it('should create form submission', async () => {
    const request = new NextRequest('http://localhost/api/form/submit', {
      method: 'POST',
      body: JSON.stringify({
        stage: 1,
        data: { companyName: 'Test' }
      })
    });
    
    const response = await POST(request);
    const data = await response.json();
    
    expect(response.status).toBe(201);
    expect(data.formId).toBeDefined();
  });
});
```

**GHL Client Tests** (`lib/ghl/__tests__/ghl-client.test.ts`)

```typescript
import { GHLClient } from '../GHLClient';

describe('GHLClient', () => {
  let client: GHLClient;
  
  beforeEach(() => {
    client = new GHLClient({
      clientId: 'test-id',
      clientSecret: 'test-secret'
    });
  });
  
  it('should generate authorization URL', () => {
    const url = client.getAuthorizationUrl('state123');
    
    expect(url).toContain('oauth/authorize');
    expect(url).toContain('client_id=test-id');
    expect(url).toContain('state=state123');
  });
  
  it('should handle token refresh', async () => {
    const mockFetch = jest.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ access_token: 'new-token' })
    });
    global.fetch = mockFetch;
    
    const newToken = await client.refreshAccessToken('old-refresh-token');
    
    expect(newToken).toBe('new-token');
    expect(mockFetch).toHaveBeenCalledWith(
      expect.stringContaining('/oauth/token'),
      expect.objectContaining({
        method: 'POST'
      })
    );
  });
});
```

