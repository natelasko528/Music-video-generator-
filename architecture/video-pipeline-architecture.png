## 🔌 **API Testing**

### **API Test Suite** (`tests/api/api.test.ts`)

```typescript
import request from 'supertest';
import { app } from '@/server'; // If using custom server

describe('Form API Endpoints', () => {
  describe('POST /api/form/submit', () => {
    it('should accept valid submission', async () => {
      const response = await request(app)
        .post('/api/form/submit')
        .send({
          stage: 1,
          data: { companyName: 'Test' }
        })
        .expect(201);
      
      expect(response.body.formId).toBeDefined();
    });
    
    it('should reject invalid data', async () => {
      const response = await request(app)
        .post('/api/form/submit')
        .send({
          stage: 1,
          data: {} // Missing required fields
        })
        .expect(400);
      
      expect(response.body.errors).toBeDefined();
    });
    
    it('should require authentication', async () => {
      await request(app)
        .post('/api/form/submit')
        .send({ stage: 1, data: {} })
        .expect(401);
    });
  });
  
  describe('GET /api/form/:id', () => {
    it('should retrieve form by ID', async () => {
      // Create form first
      const createResponse = await request(app)
        .post('/api/form/submit')
        .send({ stage: 1, data: { companyName: 'Test' } });
      
      const formId = createResponse.body.formId;
      
      // Retrieve it
      const response = await request(app)
        .get(`/api/form/${formId}`)
        .expect(200);
      
      expect(response.body.data.companyName).toBe('Test');
    });
  });
});
```

### **GHL API Integration Tests**

```typescript
describe('GHL API Operations', () => {
  let accessToken: string;
  
  beforeAll(async () => {
    // Get test token
    accessToken = await getTestGHLToken();
  });
  
  it('should create contact', async () => {
    const response = await request(app)
      .post('/api/ghl/contacts')
      .set('Authorization', `Bearer ${accessToken}`)
      .send({
        firstName: 'Test',
        lastName: 'User',
        email: 'test@example.com'
      })
      .expect(201);
    
    expect(response.body.contactId).toBeDefined();
  });
  
  it('should create subaccount', async () => {
    const response = await request(app)
      .post('/api/ghl/subaccounts')
      .set('Authorization', `Bearer ${accessToken}`)
      .send({
        name: 'Test Subaccount',
        address: '123 Test St'
      })
      .expect(201);
    
    expect(response.body.subaccountId).toBeDefined();
  });
});
```

