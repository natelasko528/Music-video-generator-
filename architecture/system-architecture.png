### Step 4: Implement Intent Classification

```python
# nlu.py

from typing import Dict, List
import re

class IntentClassifier:
    """Classify user intent from natural language"""
    
    async def classify(self, user_input: str, context: Dict) -> Dict:
        """
        Classify intent and extract entities
        
        Returns:
            {
                "primary_intent": "create" | "edit" | "adjust" | etc,
                "sub_intent": specific operation type,
                "entities": extracted entities,
                "confidence": 0.0-1.0
            }
        """
        
        text_lower = user_input.lower()
        
        # Pattern matching for intents
        if any(kw in text_lower for kw in ["create", "make", "add", "new"]):
            return {
                "primary_intent": "create",
                "sub_intent": self._detect_create_target(text_lower),
                "entities": self._extract_entities(user_input, context),
                "confidence": 0.85
            }
        
        elif any(kw in text_lower for kw in ["trim", "cut", "edit"]):
            return {
                "primary_intent": "edit",
                "sub_intent": "trim",
                "entities": self._extract_entities(user_input, context),
                "confidence": 0.9
            }
        
        elif any(kw in text_lower for kw in ["more", "less", "adjust"]):
            return {
                "primary_intent": "adjust",
                "sub_intent": "parameter",
                "entities": self._extract_entities(user_input, context),
                "confidence": 0.8
            }
        
        # Default
        return {
            "primary_intent": "unknown",
            "confidence": 0.3
        }
    
    def _extract_entities(self, text: str, context: Dict) -> Dict:
        """Extract entities from text"""
        entities = {
            "time_references": [],
            "music_sections": [],
            "adjustments": [],
            "targets": []
        }
        
        # Extract time references
        time_patterns = [r"(\d+):(\d+)", r"(\d+)s", r"at\s+(\d+)"]
        for pattern in time_patterns:
            matches = re.findall(pattern, text)
            if matches:
                entities["time_references"].extend(matches)
        
        # Extract music sections
        sections = ["intro", "verse", "chorus", "bridge", "outro"]
        for section in sections:
            if section in text.lower():
                entities["music_sections"].append(section)
        
        # Extract adjustment terms
        if "more" in text.lower():
            entities["adjustments"].append({"type": "increase", "amount": 1})
        if "less" in text.lower():
            entities["adjustments"].append({"type": "decrease", "amount": 1})
        
        return entities
```

### Step 5: Implement Context Window Management

```python
# context.py

import tiktoken

class ContextWindowManager:
    """Manage LLM context window efficiently"""
    
    def __init__(self, model: str = "gpt-4-turbo", max_tokens: int = 8000):
        self.model = model
        self.max_tokens = max_tokens
        self.encoding = tiktoken.encoding_for_model(model)
    
    def build_context(self, state, user_input: str) -> str:
        """Build optimized context"""
        
        parts = []
        budget = self.max_tokens
        
        # 1. System prompt (always include)
        system_prompt = "You are an expert music video editing assistant..."
        parts.append(system_prompt)
        budget -= self._count_tokens(system_prompt)
        
        # 2. Current turn
        current = f"User: {user_input}"
        parts.append(current)
        budget -= self._count_tokens(current)
        
        # 3. Essential context
        essential = self._format_essential_context(state)
        if self._count_tokens(essential) < budget:
            parts.append(essential)
            budget -= self._count_tokens(essential)
        
        # 4. Recent conversation (fit remaining budget)
        if budget > 0:
            history = self._format_history(state.message_history, budget)
            parts.append(history)
        
        return "\n\n".join(parts)
    
    def _count_tokens(self, text: str) -> int:
        return len(self.encoding.encode(text))
    
    def _format_essential_context(self, state) -> str:
        parts = []
        
        if state.music_analysis:
            parts.append(f"Music: {state.music_analysis.get('tempo')} BPM")
        
        if state.timeline:
            parts.append(f"Timeline: {len(state.timeline)} clips")
        
        return "\n".join(parts)
    
    def _format_history(self, messages: List[Dict], budget: int) -> str:
        # Keep most recent messages that fit budget
        formatted = []
        used_tokens = 0
        
        for msg in reversed(messages[-10:]):  # Last 10 messages
            text = f"{msg['role']}: {msg['content']}"
            tokens = self._count_tokens(text)
            
            if used_tokens + tokens < budget:
                formatted.insert(0, text)
                used_tokens += tokens
            else:
                break
        
        return "\n".join(formatted)
```

### Step 6: Implement Undo/Redo

```python
# undo.py

class ConversationalUndoRedo:
    """Natural language undo/redo system"""
    
    async def parse_undo_request(self, user_input: str, state) -> dict:
        """Parse undo request from natural language"""
        
        text_lower = user_input.lower()
        
        # Simple undo
        if text_lower in ["undo", "undo that", "go back"]:
            return {"type": "single", "steps": 1}
        
        # Multiple steps: "undo 3 steps"
        if "undo" in text_lower and any(char.isdigit() for char in text_lower):
            steps = int(''.join(filter(str.isdigit, text_lower)))
            return {"type": "multiple", "steps": steps}
        
        # Selective: "undo the color changes"
        if "color" in text_lower:
            return {"type": "selective", "operation_type": "color_grade"}
        
        return {"type": "single", "steps": 1}
    
    async def execute_undo(self, request: dict, state) -> dict:
        """Execute undo operation"""
        
        if request["type"] == "single":
            if not state.operation_stack:
                return {"success": False, "message": "Nothing to undo"}
            
            # Pop last operation
            operation = state.operation_stack.pop()
            
            # Revert operation
            await self._revert_operation(operation, state)
            
            # Add to undo stack
            state.undo_stack.append(operation)
            
            return {
                "success": True,
                "message": f"Undid: {operation.get('type')}"
            }
        
        elif request["type"] == "multiple":
            # Undo multiple operations
            steps = min(request["steps"], len(state.operation_stack))
            undone = []
            
            for _ in range(steps):
                if state.operation_stack:
                    op = state.operation_stack.pop()
                    await self._revert_operation(op, state)
                    state.undo_stack.append(op)
                    undone.append(op)
            
            return {
                "success": True,
                "message": f"Undid {len(undone)} operations"
            }
        
        # ... handle other types
    
    async def _revert_operation(self, operation: dict, state):
        """Revert specific operation"""
        # Restore state from operation's state_before
        pass
```

