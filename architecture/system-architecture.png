## Testing

### Unit Tests

```python
# tests/test_intent_classification.py

import pytest
from nlu import IntentClassifier

@pytest.mark.asyncio
async def test_create_scene_intent():
    classifier = IntentClassifier()
    
    result = await classifier.classify(
        "Create a scene at the beginning with a sunrise",
        context={}
    )
    
    assert result["primary_intent"] == "create"
    assert result["sub_intent"] == "scene"
    assert "sunrise" in result["entities"]["description"]

@pytest.mark.asyncio
async def test_trim_intent():
    classifier = IntentClassifier()
    
    result = await classifier.classify(
        "Trim the clip at 2:30",
        context={}
    )
    
    assert result["primary_intent"] == "edit"
    assert result["sub_intent"] == "trim"
    assert "2:30" in str(result["entities"]["time_references"])
```

