## Common Patterns

### Pattern 1: Music-Aware Timing

```python
# Always resolve music-relative times
def resolve_music_time(time_input: str, music_analysis: dict) -> float:
    """Convert 'chorus', 'beat:32', etc to absolute seconds"""
    
    if time_input in music_analysis["sections"]:
        return music_analysis["sections"][time_input]["start_time"]
    
    if time_input.startswith("beat:"):
        beat_num = int(time_input.split(":")[1])
        return music_analysis["beats"][beat_num]["time"]
    
    # Parse as absolute time
    return float(time_input)
```

### Pattern 2: Progressive Parameter Refinement

```python
# Track parameter changes across turns
class ParameterTracker:
    def __init__(self):
        self.history = []
    
    def apply_adjustment(self, param: str, adjustment: str, current_value: float):
        """Apply relative adjustment: 'more', 'less', etc"""
        
        delta = 0
        if adjustment == "more":
            delta = current_value * 0.2  # +20%
        elif adjustment == "less":
            delta = current_value * -0.2  # -20%
        
        new_value = current_value + delta
        
        # Track in history
        self.history.append({
            "param": param,
            "old_value": current_value,
            "new_value": new_value,
            "adjustment": adjustment
        })
        
        return new_value
```

### Pattern 3: Conversational Confirmation

```python
# Confirm destructive operations
async def handle_message(message: str, state):
    intent = await classify_intent(message)
    
    if intent["requires_confirmation"]:
        # Store pending operation
        state.pending_confirmations.append({
            "operation": intent,
            "message": f"This will {intent['description']}. Proceed?"
        })
        
        return {
            "type": "clarification",
            "message": state.pending_confirmations[-1]["message"],
            "options": ["Yes, proceed", "No, cancel"]
        }
    
    # Execute immediately
    return await execute_operation(intent, state)
```

